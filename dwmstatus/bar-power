#!/bin/sh

error_menu() {
	printf '%s\n' "$1" | dmenu -i -p "Power menu error"
}

confirm() {
	answer=$(printf 'Yes\nNo\n' | dmenu -i -p "$1?") || return 1
	[ "$answer" = "Yes" ]
}

lock_screen() {
	if command -v slock >/dev/null 2>&1; then
		exec slock
	elif command -v i3lock >/dev/null 2>&1; then
		exec i3lock
	elif command -v xsecurelock >/dev/null 2>&1; then
		exec xsecurelock
	else
		error_menu "No screen locker found (slock, i3lock, or xsecurelock)"
	fi
}

power_action() {
	action=$1
	if { pgrep -x elogind >/dev/null 2>&1 || pgrep -x elogind-daemon >/dev/null 2>&1; } &&
	   command -v loginctl >/dev/null 2>&1; then
		loginctl "$action" || error_menu "loginctl could not $action"
	elif command -v doas >/dev/null 2>&1; then
		doas "$action" || error_menu "doas could not $action"
	elif command -v sudo >/dev/null 2>&1; then
		sudo -n "$action" || error_menu "sudo could not $action without a password"
	else
		error_menu "No usable power command found (elogind, doas, or sudo)"
	fi
}

choice=$(printf 'Lock\nLogout\nRestart\nPower off\n' | dmenu -i -p "Power") || exit 0

case $choice in
	Lock)
		lock_screen
		;;
	Logout)
		if confirm "Logout"; then
			if command -v pkill >/dev/null 2>&1; then
				pkill -x dwm || pkill -x chadwm || error_menu "dwm is not running"
			else
				error_menu "pkill is not installed"
			fi
		fi
		;;
	Restart)
		confirm "Restart" && power_action reboot
		;;
	"Power off")
		confirm "Power off" && power_action poweroff
		;;
esac
